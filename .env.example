# Browser-visible configuration (public values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
VITE_VAPID_PUBLIC_KEY=YOUR_NEW_VAPID_PUBLIC_KEY

# Server-only values: configure in Vercel; never prefix secrets with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
VAPID_PUBLIC_KEY=YOUR_NEW_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_NEW_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_SUPPORT_EMAIL
